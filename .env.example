# Copy this file to .env and fill in your details.

# Your Nextcloud base URL (no trailing slash), e.g. https://cloud.example.com
NEXTCLOUD_URL=https://cloud.example.com

# The Nextcloud username that owns the app password below
NEXTCLOUD_USERNAME=yourname

# Settings > Security > Devices & sessions > Create new app password
NEXTCLOUD_APP_PASSWORD=xxxxx-xxxxx-xxxxx-xxxxx-xxxxx

# Folder (relative to your Nextcloud files root) where notes.json will live.
# It will be created automatically if it doesn't exist.
NOTES_FOLDER=NoteKeep

# Port the NoteKeep server listens on
PORT=3077

# Optional: set this to any random string to require a matching
# "x-app-token" header. Leave blank on a trusted home network if you don't
# want to bother. Recommended if you expose this beyond your LAN.
APP_TOKEN=
